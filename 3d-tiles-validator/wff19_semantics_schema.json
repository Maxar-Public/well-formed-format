          "optional": true
        },
        "MAXAR_ACQUISITION_GEOMETRY_IMAGE_COUNT": {
          "type": "SCALAR",
          "componentType": "UINT32",
          "optional": true
        },
        "MAXAR_ACQUISITION_GEOMETRY_FIRST_DATE": {
          "type": "STRING",
          "optional": true
        },
        "MAXAR_ACQUISITION_GEOMETRY_LAST_DATE": {
          "type": "STRING",
          "optional": true
        },
        "MAXAR_ACQUISITION_GEOMETRY_AVERAGE_DATE": {
