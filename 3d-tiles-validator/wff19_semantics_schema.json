          "type": "STRING",
          "optional": true
        },
        "TILE_MAXIMUM_HEIGHT": {
          "type": "SCALAR",
          "componentType": "FLOAT32",
          "optional": true
        },
        "TILE_MINIMUM_HEIGHT": {
          "type": "SCALAR",
          "componentType": "FLOAT32",
          "optional": true
        },
        "MAXAR_TEXTURE_RESOLUTION": {
          "type": "SCALAR",
          "componentType": "FLOAT32",
          "optional": true
        }
      }
    }
  }
}
