{
  "id": "WFF-Semantics-1.9.0",
  "description": "A metadata schema where each class property has a name that represents one possible semantic of a WFF 1.9.0 metadata property, and that is used for validating semantics in a given tileset JSON file, by passing it in as one of the 'semanticSchemaFileNames' of the validation options",
  "classes": {
    "WffTilesetSemantics": {
      "description": "A class where each property is a semantic for tileset metadata defined by Well-Formed Format or Maxar",
      "properties": {
        "MAXAR_CAPTURE_PLATFORM": {
          "type": "STRING",
          "optional": true
        },
        "MAXAR_CAPTURE_SENSOR": {
          "type": "STRING",
          "optional": true
        },
        "MAXAR_COLLECTION_ID": {
          "type": "STRING",
          "optional": true
        },
        "MAXAR_CONTENT_TYPE": {
          "type": "STRING",
          "optional": true
        },
        "WFF_DISTRIBUTION_CONTROLLED_BY": {
          "type": "STRING",
          "optional": true
        },
        "MAXAR_CREATION_DATE": {
          "type": "STRING",
          "optional": true
        },
        "WFF_DISTRIBUTION_CATEGORY": {
          "type": "STRING",
          "optional": true
        },
        "WFF_DISTRIBUTION_DATE": {
          "type": "STRING",
          "optional": true
        },
        "WFF_DISTRIBUTION_STATEMENT": {
          "type": "STRING",
          "optional": true
        },
        "MAXAR_EXPORT_ID": {
          "type": "STRING",
          "optional": true
        },
        "MAXAR_GEOMETRY_MODEL": {
          "type": "STRING",
          "optional": true
        },
        "ID": {
          "type": "STRING",
          "optional": true
        },
        "MAXAR_LICENSES": {
          "type": "STRING",
          "array": true,
          "optional": true
        },
        "TILESET_MATERIALS_VARIANTS_NAMES": {
          "type": "STRING",
          "array": true,
          "optional": true
        },
        "MAXAR_MAX_LEAF_TEXTURE_RESOLUTION": {
          "type": "SCALAR",
          "componentType": "FLOAT64",
          "optional": true
        },
        "MAXAR_MIN_LEAF_TEXTURE_RESOLUTION": {
          "type": "SCALAR",
          "componentType": "FLOAT64",
          "optional": true
        },
        "MAXAR_NONVISUAL_GEOMETRY_TYPES": {
          "type": "STRING",
          "array": true,
          "optional": true
        },
        "NAME": {
          "type": "STRING"
        },
