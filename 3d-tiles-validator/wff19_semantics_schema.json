        "WFF_PROVIDER": {
          "type": "STRING",
          "optional": true
        },
        "TILESET_CRS_COORDINATE_EPOCH": {
          "type": "STRING",
          "optional": true
        },
        "TILESET_CRS_GEOCENTRIC": {
          "type": "STRING",
          "optional": true
        },
        "MAXAR_RUNTIME_ENABLED": {
          "type": "BOOLEAN",
          "optional": true
        },
        "WFF_DISTRIBUTION_SECURITY": {
          "type": "STRING",
          "optional": true
        },
        "MAXAR_SOURCE_IDS": {
          "type": "STRING",
          "array": true,
          "optional": true
        },
        "MAXAR_TEXTURE_FEATURES": {
          "type": "STRING",
          "array": true,
          "optional": true
        },
        "WFF_VERSION": {
          "type": "STRING",
          "optional": false
        }
